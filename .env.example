# Copy this file to .env and fill in the values.

# A long random string. Generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Keep False in production. True shows detailed error pages.
DEBUG=False

# Comma separated host names / IPs the site is served on.
ALLOWED_HOSTS=127.0.0.1,localhost
# Full origins (with scheme) allowed to POST forms, needed when served behind a domain.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Set to True only when the site is served over HTTPS.
SECURE_COOKIES=False

# Admin account created/updated by: python manage.py ensure_admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# AI processing
# cuda or cpu (cpu is extremely slow, only for testing)
AI_DEVICE=cuda
# Tile size used for the large models; lower it if you get "out of memory" errors.
AI_TILE_SIZE=512
# auto = fast half precision with automatic repair of GPU errors (recommended)
# fp32 = always full precision: slower, only for GPUs that keep producing errors
AI_PRECISION=auto
# auto = NVIDIA hardware encoder when available, otherwise libx264 (or force nvenc / libx264)
VIDEO_ENCODER=auto
